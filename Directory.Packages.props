<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CoreLibVersion>10.0.11</CoreLibVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cloud secret-store client SDKs -->
    <PackageVersion Include="AWSSDK.SecretsManager" Version="4.0.100.13" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.11.1" />
    <PackageVersion Include="Google.Cloud.SecretManager.V1" Version="2.8.0" />

    <!-- Microsoft.Extensions.* -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="$(CoreLibVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="$(CoreLibVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="$(CoreLibVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(CoreLibVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(CoreLibVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="$(CoreLibVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(CoreLibVersion)" />

    <!-- Test infrastructure -->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
